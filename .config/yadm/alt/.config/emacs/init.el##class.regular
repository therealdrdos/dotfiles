;; Use C-M-x to evaluate while editing
;; Use C-M-i to get autocompletion inside the editor buffer
;; Packages to install system-wide for this config to work:
;; - A nerd font
;; - Linters:
;;   - ansible-lint (Ansible)
;;   - pylint (Python)
;;   - eslint (JavaScript)
;; - For Language Support:
;;   - cmake (For C/C++)
;;   - devscripts (Only on Debian, visit https://github.com/cuonglm/flycheck-checkbashisms for more)
;;   - clang-tidy (For C/C++)
;;   - tidy (For HTML)


;;; Code:
;;;; Basic Configuration

(when (fboundp 'tool-bar-mode) (tool-bar-mode -1))
(when (fboundp 'scroll-bar-mode) (scroll-bar-mode -1))
(blink-cursor-mode -1)
(global-hl-line-mode 1)
(global-display-line-numbers-mode 1)
(recentf-mode 1)
(save-place-mode 1)  ; remember edit position in files
(global-auto-revert-mode 1)  ; watch for file changes and refresh on-change
(delete-selection-mode 1)  ; selected text gets deleted when typing
(set-language-environment "UTF-8")
(prefer-coding-system 'utf-8-unix)
(setopt use-short-answers t)
(show-paren-mode 1)

;; filesystem stuff
(defconst my/cache-dir (expand-file-name "emacs-cache/" user-emacs-directory))
(defconst my/backup-dir (expand-file-name "backups/" my/cache-dir))
(defconst my/autosave-dir (expand-file-name "autosaves/" my/cache-dir))

(dolist (d (list my/cache-dir my/backup-dir my/autosave-dir))
  (unless (file-directory-p d) (make-directory d t)))

;; Keep custom-set-variables out of init.el
(setq custom-file (expand-file-name "custom-vars.el" user-emacs-directory))
(when (file-exists-p custom-file)
  (load custom-file 'noerror))

(setq backup-directory-alist `(("." . ,my/backup-dir)))
(setq auto-save-file-name-transforms `((".*" ,my/autosave-dir t)))
(setq auto-save-default t)
(setq create-lockfiles t)
(setq delete-old-versions t
      kept-new-versions 8
      kept-old-versions 1
      version-control t)

(setq initial-scratch-message nil)
(setq ring-bell-function #'ignore)
(setq global-auto-revert-non-file-buffers t) ; refresh dired and co on changes automatically
(keymap-set minibuffer-local-map "<escape>" #'minibuffer-keyboard-quit)
(setq history-length 100)
(setq recentf-max-saved-items 100)
(setq delete-by-moving-to-trash t)
(setq-default indent-tabs-mode nil)
(setq-default tab-width 4)
(setq require-final-newline t)

;;; Keybinding to open init.el quickly
(defun init ()
  "Quickly open the init.el config file."
  (interactive)
  (find-file "~/.config/emacs/init.el"))


;;;; Package Management

;; Setup
(require 'package)
(setq package-archives '(("melpa" . "https://melpa.org/packages/")
                         ("gnu" . "https://elpa.gnu.org/packages/")
                         ("nongnu" . "https://elpa.nongnu.org/nongnu/")))
;; package.el auto-activates at startup; only the archive index needs loading.
(package-read-all-archive-contents)
(unless package-archive-contents
  (package-refresh-contents))
(require 'use-package)
(setq use-package-always-ensure t)
(setq use-package-always-defer t)
;; :after is not a load trigger -- blocks need :hook/:bind/:mode or :demand t.

;; package.el only records what it installs itself.  Applied at the end
;; because load-theme reloads custom-file and would drop it if set earlier.
(defvar my/ensured-packages nil)

(defun my/note-package (sym)
  "Add SYM to the list of packages this config wants installed."
  (when (and sym (not (memq sym my/ensured-packages)))
    (push sym my/ensured-packages)))

(defun my/note-selected (name args &rest _)
  "Note NAME as wanted when use-package ensures it.  ARGS is its :ensure value."
  (dolist (a args)
    (when a
      (my/note-package (cond ((eq a t) (use-package-as-symbol name))
                             ((consp a) (car a))
                             (t a))))))

(defun my/apply-selected-packages ()
  "Fold the packages init.el asked for into `package-selected-packages'."
  (setq package-selected-packages
        (delete-dups (append my/ensured-packages package-selected-packages))))

(advice-add 'use-package-ensure-elpa :before #'my/note-selected)

;; Platform-specific config.
(load (expand-file-name "platform-config" user-emacs-directory) t)


;;;; Theming

;; Theme
(use-package solarized-theme
  :ensure t
  :demand t
  :init
  (setq solarized-use-variable-pitch t)
  (setq solarized-scale-org-headlines nil)   ; org-level-* sizes come from the user theme
  (setq solarized-high-contrast-mode-line t)
  (setq solarized-highlight-numbers t)
  :config
  (load-theme 'solarized-light t))

(add-hook 'text-mode-hook #'visual-line-mode)

(setq-default line-spacing 0.15)
(setq-default fill-column 80)

(global-display-fill-column-indicator-mode t) ; visual line after 80 chars

;; Nerd Font (platform-specific font size loaded from platform-config.el)
(use-package nerd-icons
  :ensure t
  :demand t)

(use-package doom-modeline
  :ensure t
  :demand t
  :init (doom-modeline-mode 1))

(use-package dashboard
  :ensure t
  :demand t
  :config
  (setq dashboard-startup-banner 'official
        dashboard-items '((recents  . 4)
                          (bookmarks . 5)))
  (dashboard-setup-startup-hook)
  (setq initial-buffer-choice
        (lambda () (get-buffer-create dashboard-buffer-name))))


;;;; Org-Mode
(require 'org)

;; Face tweaks live in the `user' theme so they survive load-theme.
(custom-theme-set-faces 'user
 `(org-document-title  ((t (:font ,my/mono-font :weight bold :height 1.8))))
 `(org-level-1         ((t (:font ,my/mono-font :weight bold :height 1.35))))
 `(org-level-2         ((t (:font ,my/mono-font :weight bold :height 1.3))))
 `(org-level-3         ((t (:font ,my/mono-font :weight bold :height 1.2))))
 `(org-level-4         ((t (:font ,my/mono-font :weight bold :height 1.1))))
 `(org-level-5         ((t (:font ,my/mono-font :weight bold :height 1.1))))
 `(org-level-6         ((t (:font ,my/mono-font :weight bold :height 1.1))))
 `(org-level-7         ((t (:font ,my/mono-font :weight bold :height 1.1))))
 `(org-level-8         ((t (:font ,my/mono-font :weight bold :height 1.1))))
 '(org-block           ((t (:inherit fixed-pitch :height 0.85))))
 '(org-code            ((t (:inherit (shadow fixed-pitch) :height 0.85))))
 '(org-verbatim        ((t (:inherit (shadow fixed-pitch) :height 0.85))))
 '(org-special-keyword ((t (:inherit (font-lock-comment-face fixed-pitch)))))
 '(org-meta-line       ((t (:inherit (font-lock-comment-face fixed-pitch)))))
 '(org-checkbox        ((t (:inherit fixed-pitch))))
 '(org-table           ((t (:inherit fixed-pitch))))
 '(org-indent          ((t (:inherit (org-hide fixed-pitch) :height 0.85)))))

(global-set-key (kbd "C-c l") #'org-store-link)
(global-set-key (kbd "C-c a") #'org-agenda)
(global-set-key (kbd "C-c n") #'org-capture)   ; C-c c belongs to claude-code

(setq org-log-done 'time)
(setq org-directory "~/Documents/Notizen/")

(setq org-capture-templates
      '(("i" "Inbox" entry (file+headline "todo/agenda.org" "Inbox")
         "* TODO %i\n%U\n%a" :immediate-finish t)
        ("t" "Task" entry (file+headline "todo/agenda.org" "Inbox")
         "* TODO %^{What} %^g\n%U\n%a\n%?" :empty-lines 1)))

(defun my/capture-frame-cleanup ()
  "Close a frame that was opened only to capture."
  (when (equal "capture" (frame-parameter nil 'name))
    (delete-frame)))

(add-hook 'org-capture-after-finalize-hook #'my/capture-frame-cleanup)
(add-hook 'org-capture-mode-hook #'delete-other-windows)

;; PROJ has no follow-up left -> stuck.  The default matcher expects
;; TODO/NEXT/NEXTACTION and never matches these keywords.
(setq org-stuck-projects
      '("/PROJ" ("TODO" "URGENT" "ONGOING" "WAITING") nil "SCHEDULED:\\|DEADLINE:")
      org-enforce-todo-dependencies t)

(setq org-agenda-custom-commands
      '(("d" "Today"
         ((agenda "" ((org-agenda-span 1)))
          (todo "URGENT|ONGOING" ((org-agenda-overriding-header "In flight")))
          (todo "WAITING|HOLD" ((org-agenda-overriding-header "Blocked")))))
        ("w" "This week"
         ((agenda "" ((org-agenda-span 7)))
          (todo "URGENT|ONGOING" ((org-agenda-overriding-header "In flight")))
          (todo "WAITING" ((org-agenda-overriding-header "Waiting on others")))
          (stuck "" ((org-agenda-overriding-header "Stalled projects")))))))

(use-package toc-org ; enabling table of contents
  :ensure t
  :commands toc-org-enable
  :init (add-hook 'org-mode-hook 'toc-org-enable))

(add-hook 'org-mode-hook 'variable-pitch-mode)

;; Fix latex preview size
(plist-put org-format-latex-options :scale 2)

;; Declutter stuff
(setq org-adapt-indentation nil   ; org-indent-mode indents visually already
      org-hide-leading-stars t
      org-hide-emphasis-markers t
      org-pretty-entities t
      org-ellipsis "  -><-"
      org-startup-folded 'content
      org-log-into-drawer t)

;; Display code blocks normally and fix tab usage inside of code blocks
(setq org-src-fontify-natively t
      org-src-tab-acts-natively t
      org-edit-src-content-indentation 0)

(add-hook 'org-mode-hook 'org-indent-mode)
(add-hook 'org-mode-hook (lambda () (org-superstar-mode 1)))

;; Org-babel: enable execution of code blocks
(org-babel-do-load-languages
 'org-babel-load-languages
 '((emacs-lisp . t)
   (shell      . t)
   (plantuml   . t)))
(setq org-plantuml-exec-mode 'plantuml)

(setq org-todo-keywords
      '((sequence
         "PROJ(p)"
         "HOLD(h)"
         "|"
         "DONE(d)" "CANCELLED(c)")

        (sequence
         "TODO(t)" "URGENT(u)" "ONGOING(o)" "WAITING(w)"
         "|"
         "ABORT(a)")))

;; Highlight TODO and other words
(use-package hl-todo
  :ensure t
  :demand t
  :hook ((org-mode . hl-todo-mode)
         (prog-mode . hl-todo-mode))
  :config
  (setq hl-todo-highlight-punctuation ":"
        hl-todo-keyword-faces
        `(("TODO"       warning bold)
          ("URGENT"     error bold)
          ("DONE"       success bold)
          ("PROJ"       font-lock-constant-face bold)
          ("HOLD"       shadow)
          ("CANCELLED"  shadow bold)
          ("ONGOING"    font-lock-keyword-face bold)
          ("WAITING"    font-lock-string-face bold)
          ("ABORT"      shadow bold))))

(setq org-lowest-priority ?F)  ;; Gives us priorities A through F
(setq org-default-priority ?E) ;; If an item has no priority, it is considered [#E]

(setq org-priority-faces
      '((65 . "#BF616A")
        (66 . "#EBCB8B")
        (67 . "#B48EAD")
        (68 . "#81A1C1")
        (69 . "#5E81AC")
        (70 . "#4C566A")))

(setq org-auto-align-tags t
      org-tags-column 0
      org-fold-catch-invisible-edits 'show-and-error
      org-special-ctrl-a/e t
      org-insert-heading-respect-content t

      org-agenda-tags-column 0
      org-agenda-block-separator ?─
      org-agenda-time-grid
      '((daily today require-timed)
        (800 1000 1200 1400 1600 1800 2000)
        " ┄┄┄┄┄ " "┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄")
      org-agenda-current-time-string
      "⭠ now ─────────────────────────────────────────────────")

;; Hooked rather than demanded, org-modern requires org.
(use-package org-modern
  :ensure t
  :hook ((org-mode . org-modern-mode)
         (org-agenda-finalize . org-modern-agenda))
  :init
  ;; org-superstar owns the stars and todo bullets, org-modern the rest
  (setq org-modern-todo nil
        org-modern-star nil
        org-modern-table nil))   ; valign handles alignment

;; Pixel-level table alignment for variable-pitch-mode
(use-package valign
  :ensure t
  :hook (org-mode . valign-mode)
  :config
  (setq valign-fancy-bar t))

(use-package org-superstar
  :ensure t
  :config
  (setq org-superstar-leading-bullet " ")
  (setq org-superstar-special-todo-items t) ;; Makes TODO header bullets into boxes
  (setq org-superstar-todo-bullet-alist '(("TODO" . 9744)
                                          ("DONE" . 9744)
                                          ("URGENT" . 9744)
                                          ("ONGOING" . 9744)
                                          ("WAITING" . 9744)
                                          ("CANCELLED" . 9744)
                                          ("PROJ" . 9744)
                                          ("HOLD" . 9744)
                                          ("ABORT" . 9744)
                                          ("POSTPONED" . 9744))))

;;;; Org mode custom functions
(defun my/org-fold-completed-tasks ()
  "Fold all DONE tasks in buffer."
  (interactive)
  (when (derived-mode-p 'org-mode)
    (save-excursion
      (org-fold-show-all)

      (org-map-entries
       (lambda ()
         (let ((state (org-get-todo-state)))
           (when (and state (member state org-done-keywords))
             (org-fold-subtree t))))
       nil 'file))))

;;;; Minibuffer tweaks

;; Minibuffer completions
